rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isHead() {
      return signedIn()
        && (
          request.auth.token.email == "head@panchayat.com"
          || request.auth.uid == "SOCIETY_HEAD_UID"
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && (
          request.auth.uid == userId
          || isHead()
        );
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || isHead()
        );
    }

    match /helpOffers/{helpId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.requesterId == request.auth.uid
          || isHead()
        );
    }

    match /emergencyAlerts/{alertId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || resource.data.responderId == request.auth.uid
          || isHead()
        );
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if isHead();
      allow update: if signedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isHead();
      allow update: if isHead();
      allow delete: if isHead();
    }
  }
}
